{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "api-provider/claude-sonnet-4.5",
  "provider": {
    "api-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "API Provider",
      "options": {
        "baseURL": "{file:~/.opencode/.secrets/api-provider-baseurl}",
        "apiKey": "{file:~/.opencode/.secrets/api-provider-key}"
      },
      "models": {
        "claude-sonnet-4.5":  { "name": "Claude Sonnet 4.5  [$3/$15]"   },
        "claude-sonnet-3.7":  { "name": "Claude Sonnet 3.7  [$3/$15]"   },
        "claude-haiku-3":     { "name": "Claude Haiku 3     [$0.25/$1.25]" },
        "o1":                 { "name": "o1                 [$15/$60]"   },
        "o3":                 { "name": "o3                 [$2/$8]"     },
        "o3-mini":            { "name": "o3-mini            [$1.10/$4.40]" },
        "o4-mini":            { "name": "o4-mini            [$1.10/$4.40]" },
        "gpt-5.4":            { "name": "GPT-5.4            [$2.50/$15]" },
        "gpt-5.2":            { "name": "GPT-5.2            [$1.75/$14]" },
        "gpt-5":              { "name": "GPT-5              [$1.25/$10]" },
        "gpt-5.1":            { "name": "GPT-5.1            [$1.25/$10]" },
        "gpt-5-mini":         { "name": "GPT-5 Mini         [$0.25/$2]"  },
        "gpt-5-nano":         { "name": "GPT-5 Nano         [$0.05/$0.40]" },
        "gpt-4o":             { "name": "GPT-4o             [$2.50/$10]" },
        "gpt-4.1":            { "name": "GPT-4.1            [$2/$8]"     },
        "gpt-4.1-mini":       { "name": "GPT-4.1 Mini       [$0.40/$1.60]" },
        "gpt-4.1-nano":       { "name": "GPT-4.1 Nano       [$0.10/$0.40]" }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  }
}
